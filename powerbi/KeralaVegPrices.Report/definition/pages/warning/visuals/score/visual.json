{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.1.0/schema.json",
  "name": "score",
  "position": {
    "x": 224,
    "y": 226,
    "z": 8000,
    "width": 1032,
    "height": 220,
    "tabOrder": 8000
  },
  "visual": {
    "visualType": "lineChart",
    "drillFilterOtherVisuals": true,
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Date"
                    }
                  },
                  "Property": "Date"
                }
              },
              "queryRef": "Date.Date",
              "nativeQueryRef": "Date"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Predictions"
                    }
                  },
                  "Property": "Warning Score"
                }
              },
              "queryRef": "Predictions.Warning Score",
              "nativeQueryRef": "Warning Score"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Predictions"
                    }
                  },
                  "Property": "Alert Threshold"
                }
              },
              "queryRef": "Predictions.Alert Threshold",
              "nativeQueryRef": "Alert Threshold"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Highest warning score among the selected crops vs the alert threshold, test period'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "12D"
                }
              }
            }
          }
        }
      ]
    }
  }
}
