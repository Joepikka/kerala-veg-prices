{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.1.0/schema.json",
  "name": "byBand",
  "position": {
    "x": 224,
    "y": 100,
    "z": 5000,
    "width": 400,
    "height": 260,
    "tabOrder": 5000
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "drillFilterOtherVisuals": true,
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Markets"
                    }
                  },
                  "Property": "band"
                }
              },
              "queryRef": "Markets.band",
              "nativeQueryRef": "band"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Market Month"
                    }
                  },
                  "Property": "Average Gap"
                }
              },
              "queryRef": "Market Month.Average Gap",
              "nativeQueryRef": "Average Gap"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Average gap to the Kerala median, by region'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "12D"
                }
              }
            }
          }
        }
      ]
    }
  }
}
