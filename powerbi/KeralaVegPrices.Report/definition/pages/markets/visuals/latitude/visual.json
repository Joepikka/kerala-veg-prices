                  "Property": "market"
                }
              },
              "queryRef": "Markets.market",
              "nativeQueryRef": "market"
            }
          ]
        },
        "X": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Markets"
                    }
                  },
                  "Property": "Latitude"
                }
              },
              "queryRef": "Markets.Latitude",
              "nativeQueryRef": "Latitude"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Market Month"
                    }
                  },
                  "Property": "Gap vs Kerala Median"
                }
              },
              "queryRef": "Market Month.Gap vs Kerala Median",
