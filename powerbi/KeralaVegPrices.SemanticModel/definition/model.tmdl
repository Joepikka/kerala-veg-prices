model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

ref table Date
ref table Crop
ref table 'Daily Price'
ref table 'Market Month'
ref table Markets
ref table 'Hub Week'
ref table 'Spike Events'
ref table Predictions
ref table 'Model Scores'
